---
import { getPublishedPosts } from "../lib/posts";
import { toBlogInfos, buildSectionTree, topLevelSections } from "../lib/sections";
import ContentPanel from "./ContentPanel.astro";
import TagCloud from "./TagCloud.astro";
import AuthorCloud from "./AuthorCloud.astro";
import { postRoute, sectionRoute, blogRoute, authorRoute, formatDate } from "../lib/routes"; // Added formatDate

interface Props {
  world: string;
}

const { world } = Astro.props;

// Sorted newest-first up front -- "Recent Posts" below depends on it, and
// nothing else here cares about order (toBlogInfos groups by blogUuid;
// AuthorCloud/TagCloud only aggregate counts), so one sort covers every
// consumer rather than sorting again just for the slice(0, 5).
const allPosts = (await getPublishedPosts())
  .filter((post) => post.data.world === world)
  .sort((a, b) => b.data.publishedAt - a.data.publishedAt);
const blogInfos = toBlogInfos(allPosts);
const rootLevelBlogs = blogInfos.filter((b) => !b.root);
const rootLevelSections = topLevelSections(buildSectionTree(blogInfos));

// 1. Map Recent Posts into ContentPanel Item structure (incorporating blog titles and proper formatting)
const recentPostsItems = allPosts.slice(0, 5).map((post) => ({
  title: post.data.title,
  href: postRoute(post.data),
  authorName: post.data.author?.name,
  authorHref: authorRoute(post.data),
  subLabels: [post.data.blogTitle],
  dateLabel: formatDate ? formatDate(post.data.publishedAt) : post.data.publishedAt,
  frontImage: post.data.frontImage
}));

// 2. Map Sections and Blogs into a single unified Browse panel array --
// no separate Search entry here anymore: the persistent header search box
// (Layout.astro) already covers that on every page, including this one.
const browseItems = [
  ...rootLevelSections.map((s) => ({
    title: s.label,
    href: sectionRoute(s.world, s.slug),
    metaType: 'section' as const
  })),
  ...rootLevelBlogs.map((blog) => ({
    title: blog.blogTitle,
    href: blogRoute(blog)
    // No author here -- see BlogInfo's own doc comment (lib/sections.ts):
    // a blog's posts can each have their own author now, so there's no
    // single reliable one to show for the blog itself.
  }))
];
---

{ allPosts.length === 0 ? (
  <p class="empty-state">
    No posts yet. Run <code>node scripts/ingest.js &lt;payload.json&gt;</code> from the repo root, then restart the dev server.
  </p>
) : (
  <div class="world-dashboard">
    {/* Left Column: Primary Content Feed */}
    <div class="main-column">
      <ContentPanel title="Recent Posts" items={recentPostsItems} />
    </div>
    
    {/* Right Column: Navigation & Indices */}
    <div class="sidebar-column">
      <ContentPanel title="Browse" items={browseItems} />
      <AuthorCloud posts={allPosts} />
      <TagCloud posts={allPosts} />
    </div>
  </div>
) }

<style>
  /* --- Structural Dashboard Grid Layout --- */
  .world-dashboard {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: 2rem;
  }

  /* Responsive desktop split matching traditional rulebook sidebars */
  @media (min-width: 900px) {
    .world-dashboard {
      display: grid;
      grid-template-columns: 1.6fr 1fr; /* Roomy left main container, compact right rail */
      gap: 4.5rem;
    }
  }

  .sidebar-column {
    display: flex;
    flex-direction: column;
    gap: 3.5rem; /* Separates the Browse section from the TagCloud stack */
  }
</style>
