{
  "name": "@world2web/site",
  "version": "0.1.0",
  "description": "The World2Web campaign site, as an Astro integration. Renders journals published from Foundry VTT by the World2Web module.",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": ["astro-integration", "astro-component", "foundry-vtt", "world2web"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gludington/world2web-site-template.git",
    "directory": "packages/site"
  },
  "exports": {
    ".": "./index.mjs",
    "./content-config": "./src/content.config.ts"
  },
  "bin": {
    "world2web-ingest": "./scripts/ingest.js"
  },
  "files": ["index.mjs", "src", "scripts"],
  "peerDependencies": {
    "astro": "7.2.4"
  },
  "dependencies": {
    "pagefind": "^1.5.2"
  }
}
